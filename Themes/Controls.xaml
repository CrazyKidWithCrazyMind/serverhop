<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:ServerHop.Core">

    <core:IntEqualsConverter x:Key="Conv.IntEq" />
    <core:BoolToVisibilityConverter x:Key="Conv.BoolVis" />

    <!-- ══════════════════ CARDS ══════════════════ -->
    <Style x:Key="Fx.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#A3FF12" BlurRadius="22" ShadowDepth="0" Opacity="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0.10" Duration="0:0:0.25" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" To="0" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Fx.Hero" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#A3FF12" BlurRadius="40" ShadowDepth="0" Opacity="0.06" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Fx.Terminal" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Terminal}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- ══════════════════ TEXT ══════════════════ -->
    <Style x:Key="Fx.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Dim}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Fx.Hair" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.LineSoft}" />
    </Style>

    <!-- ══════════════════ GENERIC BUTTON ══════════════════ -->
    <Style x:Key="Fx.Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scl" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Face" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                CornerRadius="8" />
                        <Border x:Name="Glow" Background="Transparent" CornerRadius="8" Margin="-2" Opacity="0" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect Color="#A3FF12" BlurRadius="18" ShadowDepth="0" Opacity="0.85" />
                            </Border.Effect>
                        </Border>
                        <Ellipse x:Name="Ripple" Width="12" Height="12" Fill="#3DA3FF12" Opacity="0"
                                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="RipS" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="#41543F" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RipOn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="0.965" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="0.965" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:0.55" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="RipS" Storyboard.TargetProperty="ScaleX" From="0.5" To="26" Duration="0:0:0.55" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="RipS" Storyboard.TargetProperty="ScaleY" From="0.5" To="26" Duration="0:0:0.55" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="RipOn" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- acid outline variant -->
    <Style x:Key="Fx.BtnAcid" TargetType="Button" BasedOn="{StaticResource Fx.Btn}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Acid}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scl" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Face" Background="{DynamicResource Brush.AcidWash}"
                                BorderBrush="#3E5A14" BorderThickness="1" CornerRadius="8" />
                        <Border x:Name="Glow" Background="Transparent" CornerRadius="8" Margin="-2" Opacity="0" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect Color="#A3FF12" BlurRadius="20" ShadowDepth="0" Opacity="0.9" />
                            </Border.Effect>
                        </Border>
                        <Ellipse x:Name="Ripple" Width="12" Height="12" Fill="#55A3FF12" Opacity="0"
                                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="RipS" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#23330B" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Brush.Acid}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RipOn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="0.965" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="0.965" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Opacity" From="0.7" To="0" Duration="0:0:0.55" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="RipS" Storyboard.TargetProperty="ScaleX" From="0.5" To="26" Duration="0:0:0.55" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="RipS" Storyboard.TargetProperty="ScaleY" From="0.5" To="26" Duration="0:0:0.55" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="RipOn" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════ HERO PLAY BUTTON ══════════════════ -->
    <Style x:Key="Fx.Play" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Black}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5" ClipToBounds="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scl" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Halo" Background="Transparent" CornerRadius="18" Margin="-8" Opacity="0.35" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect Color="#A3FF12" BlurRadius="46" ShadowDepth="0" Opacity="1" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Face" Background="{DynamicResource Brush.Acid}" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect Color="#7ACC00" BlurRadius="10" ShadowDepth="0" Opacity="0.55" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Sheen" CornerRadius="14" Margin="1" Opacity="0" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#66FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Ellipse x:Name="Ripple" Width="14" Height="14" Fill="#66FFFFFF" Opacity="0"
                                 IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="RipS" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="Bolt" Data="M13 2 L4 14 h6 l-1 8 9 -12 h-6 z"
                                  Fill="{TemplateBinding Foreground}" Stretch="Uniform"
                                  Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.AcidDeep}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RipOn">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Ripple" Storyboard.TargetProperty="Opacity" From="0.75" To="0" Duration="0:0:0.6" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="RipS" Storyboard.TargetProperty="ScaleX" From="0.5" To="30" Duration="0:0:0.6" RepeatBehavior="Forever" />
                                        <DoubleAnimation Storyboard.TargetName="RipS" Storyboard.TargetProperty="ScaleY" From="0.5" To="30" Duration="0:0:0.6" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="RipOn" />
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════ WINDOW CHROME BUTTONS ══════════════════ -->
    <Style x:Key="Fx.WinBtn" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Face" Background="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#1C221F" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#252C28" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Fx.WinBtnClose" TargetType="Button" BasedOn="{StaticResource Fx.WinBtn}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Face" Background="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#C50F1F" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════ NAV BUTTON ══════════════════ -->
    <Style x:Key="Fx.Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Dim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scl" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Face" Background="Transparent" CornerRadius="9" Margin="6,5" />
                        <Border x:Name="Ind" Width="3" Height="26" CornerRadius="2"
                                HorizontalAlignment="Left" Margin="0,0,0,0" Background="{DynamicResource Brush.Acid}"
                                Opacity="0" IsHitTestVisible="False" />
                        <StackPanel x:Name="Body" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter HorizontalAlignment="Center" />
                            <TextBlock x:Name="Label" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{DynamicResource Font.Mono}" FontSize="8.5" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#141A17" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#171F15" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Acid}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ind" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Ind" Storyboard.TargetProperty="Height" To="34" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.6" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ind" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="Ind" Storyboard.TargetProperty="Height" To="26" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════ SEGMENTED PILL ══════════════════ -->
    <Style x:Key="Fx.Seg" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Face" Background="Transparent" CornerRadius="6" Padding="13,7"
                            BorderThickness="0" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Scl" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="#A3FF12" BlurRadius="14" ShadowDepth="0" Opacity="0" x:Name="GlowFx" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Acid}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Black}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" From="0.92" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.5" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" From="0.92" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.5" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Face" Property="Background" Value="#1B211E" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- quality bar segment (narrow) -->
    <Style x:Key="Fx.SegBar" TargetType="RadioButton" BasedOn="{StaticResource Fx.Seg}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Face" Background="#161C19" CornerRadius="5" Padding="0"
                            Width="34" Height="32" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5"
                            BorderThickness="0">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Scl" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect Color="#A3FF12" BlurRadius="14" ShadowDepth="0" Opacity="0" x:Name="GlowFx" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="#232B26" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Acid}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Black}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleX" From="0.85" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.7" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Scl" Storyboard.TargetProperty="ScaleY" From="0.85" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.7" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="GlowFx" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════ TOGGLE SWITCH ══════════════════ -->
    <Style x:Key="Fx.Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Width="48" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Right">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="HovScl" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Track" Width="46" Height="26" CornerRadius="13"
                                Background="#1B211E" BorderBrush="#2A322E" BorderThickness="1" />
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#6E7A71"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="Slide" X="0" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#A3FF12" BlurRadius="10" ShadowDepth="0" Opacity="0" x:Name="KnobGlow" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="46" Height="26" Fill="Transparent" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HovScl" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="HovScl" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HovScl" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="HovScl" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Acid}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Acid}" />
                            <Setter TargetName="Knob" Property="Fill" Value="#0A0C0B" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.45" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="KnobGlow" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="KnobGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════ SCROLLBAR ══════════════════ -->
    <Style x:Key="Fx.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="9" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Maximum="100" Minimum="0" Value="50">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#2C3833" CornerRadius="4" Margin="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Width" Value="11" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════ PROGRESS ══════════════════ -->
    <Style x:Key="Fx.Progress" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Acid}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Background="{TemplateBinding Background}" ClipToBounds="True">
                        <Rectangle x:Name="Indicator" Fill="{TemplateBinding Foreground}" Width="86" Height="4"
                                   RadiusX="2" RadiusY="2" HorizontalAlignment="Left" IsHitTestVisible="False">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="SlideT" X="-90" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SlideT" Storyboard.TargetProperty="X"
                                                     From="-90" To="300" Duration="0:0:1.15" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
