<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ FONTS (OFL licensed, embedded) ============ -->
    <FontFamily x:Key="Font.Display">pack://application:,,,/Assets/Fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI, Chakra Petch</FontFamily>

    <!-- ============ CORE SURFACES ============ -->
    <SolidColorBrush x:Key="Brush.Bg" Color="#0A0C0B" />
    <SolidColorBrush x:Key="Brush.Rail" Color="#0C0F0E" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#101413" />
    <SolidColorBrush x:Key="Brush.Card" Color="#141A18" />
    <SolidColorBrush x:Key="Brush.CardHover" Color="#1A211E" />
    <SolidColorBrush x:Key="Brush.Well" Color="#0B0E0D" />
    <SolidColorBrush x:Key="Brush.Terminal" Color="#070908" />
    <SolidColorBrush x:Key="Brush.Line" Color="#232A27" />
    <SolidColorBrush x:Key="Brush.LineSoft" Color="#1A201E" />

    <!-- ============ TEXT ============ -->
    <SolidColorBrush x:Key="Brush.Text" Color="#E9F1E6" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#8A968B" />
    <SolidColorBrush x:Key="Brush.Dim" Color="#59625B" />
    <SolidColorBrush x:Key="Brush.Black" Color="#0A0C0B" />

    <!-- ============ ACCENT: ACID GREEN ============ -->
    <SolidColorBrush x:Key="Brush.Acid" Color="#A3FF12" />
    <SolidColorBrush x:Key="Brush.AcidDeep" Color="#8BE000" />
    <SolidColorBrush x:Key="Brush.AcidDim" Color="#2C3D10" />
    <SolidColorBrush x:Key="Brush.AcidWash" Color="#16210C" />
    <Color x:Key="Color.Acid">#A3FF12</Color>

    <!-- ============ SIGNALS ============ -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF4B3E" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#FFB020" />

</ResourceDictionary>
