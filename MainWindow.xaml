<Window x:Class="ServerHop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SERVERHOP — Roblox Server Picker"
        Height="760" Width="1160" MinHeight="660" MinWidth="1040"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Font.Body}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Assets/icon.ico"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                      GlassFrameThickness="0" CornerRadius="12"
                      UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- CRT scanline texture -->
        <DrawingBrush x:Key="Brush.Scanline" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute" Stretch="None" Opacity="0.5">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M0,0 H3 V1 H0 Z" Brush="#07FFFFFF" />
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="StatusPulse" TargetType="Ellipse">
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.35" Duration="0:0:1.1"
                                             AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- all scrollbars in the window inherit the slim acid style -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Fx.ScrollBar}" />

        <!-- type-once input hint (visible while the box is empty) -->
        <Style x:Key="InputHint" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Dim}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- one server row: transparent until hovered -->
        <Style x:Key="SrvRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Padding" Value="12,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.CardHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="12">

        <Border Background="{DynamicResource Brush.Bg}"
                BorderBrush="{DynamicResource Brush.Line}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="6" Direction="270" Opacity="0.55" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ═══════════════ HEADER ═══════════════ -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Rail}"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <Path Data="M13 2 L4 14 h6 l-1 8 9 -12 h-6 z"
                                  Fill="{DynamicResource Brush.Acid}"
                                  Width="17" Height="17"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="SERVERHOP"
                                       FontFamily="{DynamicResource Font.Display}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text}"
                                       Margin="10,1,0,0"
                                       VerticalAlignment="Center" />
                            <Border Background="{DynamicResource Brush.AcidWash}"
                                    CornerRadius="4"
                                    Padding="9,3"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="ROBLOX SERVER PICKER"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Acid}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0">
                            <!-- status pill -->
                            <Border CornerRadius="11"
                                    Padding="11,5"
                                    Background="{DynamicResource Brush.Card}"
                                    BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Status">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7"
                                             Fill="{Binding StatusBrush}"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource StatusPulse}" />
                                    <TextBlock Text="{Binding StatusText}"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{Binding StatusBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="v1.0.0"
                                       FontFamily="{DynamicResource Font.Mono}"
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.Dim}"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center" />

                            <Button Style="{StaticResource Fx.WinBtn}"
                                    Click="Min_Click"
                                    AutomationProperties.Name="Minimize">
                                <Path Data="M0.5,5 H9.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" />
                            </Button>

                            <Button Style="{StaticResource Fx.WinBtn}"
                                    Click="Max_Click"
                                    AutomationProperties.Name="Maximize">
                                <Path x:Name="MaxGlyph"
                                      Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" />
                            </Button>

                            <Button Style="{StaticResource Fx.WinBtnClose}"
                                    Click="Close_Click"
                                    AutomationProperties.Name="Close">
                                <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════ BODY ═══════════════ -->
                <Grid Grid.Row="1" Margin="26,20,26,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ── hero: input + loaded game ── -->
                    <Border Grid.Row="0" Style="{StaticResource Fx.Hero}" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- game icon (hidden until a game is loaded) -->
                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                    Width="52" Height="52"
                                    CornerRadius="10"
                                    Background="{DynamicResource Brush.Well}"
                                    BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasGame, Converter={StaticResource Conv.BoolVis}}">
                                <Grid>
                                    <Path Data="M13 2 L4 14 h6 l-1 8 9 -12 h-6 z"
                                          Fill="{DynamicResource Brush.Acid}"
                                          Opacity="0.35"
                                          Width="20" Height="20"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <Rectangle RadiusX="10" RadiusY="10">
                                        <Rectangle.Fill>
                                            <ImageBrush ImageSource="{Binding GameIcon}" Stretch="UniformToFill" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>

                            <!-- link / place-id box -->
                            <Border x:Name="InputWrap" Grid.Row="0" Grid.Column="1"
                                    Height="46"
                                    Margin="0,0,12,0"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Line}"
                                    Background="{DynamicResource Brush.Well}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=InputBox}" Value="True">
                                                <Setter Property="BorderBrush" Value="#41543F" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=InputBox}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Acid}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBox x:Name="InputBox"
                                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource Brush.Text}"
                                             CaretBrush="{DynamicResource Brush.Acid}"
                                             SelectionBrush="#3E5A14"
                                             FontFamily="{DynamicResource Font.Mono}"
                                             FontSize="14"
                                             Padding="16,0"
                                             VerticalContentAlignment="Center"
                                             KeyDown="InputBox_KeyDown"
                                             AutomationProperties.Name="Game link or place ID" />
                                    <TextBlock Style="{StaticResource InputHint}"
                                               Text="https://www.roblox.com/games/4924922222/…   or   a place ID" />
                                </Grid>
                            </Border>

                            <Button Grid.Row="0" Grid.Column="2"
                                    Style="{StaticResource Fx.BtnAcid}"
                                    Content="LOAD"
                                    Height="46"
                                    Padding="30,0"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Click="Load_Click"
                                    AutomationProperties.Name="Load game" />

                            <!-- loaded game meta -->
                            <StackPanel Grid.Row="1" Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="2,11,0,0"
                                        Visibility="{Binding HasGame, Converter={StaticResource Conv.BoolVis}}">
                                <TextBlock Text="{Binding GameName}"
                                           FontFamily="{DynamicResource Font.Display}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="460"
                                           VerticalAlignment="Center" />
                                <Border Width="1" Height="12"
                                        Background="{DynamicResource Brush.Line}"
                                        Margin="11,0"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GameMeta}"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Muted}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- busy indicator -->
                    <ProgressBar Grid.Row="1"
                                 Style="{StaticResource Fx.Progress}"
                                 IsIndeterminate="True"
                                 Foreground="{DynamicResource Brush.Acid}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource Conv.BoolVis}}"
                                 AutomationProperties.Name="Loading" />

                    <!-- ── toolbar ── -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SORT"
                                       Style="{StaticResource Fx.SectionLabel}"
                                       Margin="2,0,0,0"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                <RadioButton Style="{StaticResource Fx.Seg}" Content="PING" GroupName="sort"
                                             IsChecked="{Binding SortMode, Mode=TwoWay, Converter={StaticResource Conv.IntEq}, ConverterParameter=0}"
                                             AutomationProperties.Name="Sort by ping" />
                                <RadioButton Style="{StaticResource Fx.Seg}" Content="PLAYERS" GroupName="sort"
                                             IsChecked="{Binding SortMode, Mode=TwoWay, Converter={StaticResource Conv.IntEq}, ConverterParameter=1}"
                                             AutomationProperties.Name="Sort by players" />
                            </StackPanel>

                            <Button Style="{StaticResource Fx.Btn}"
                                    Click="Dir_Click"
                                    Margin="10,0,0,0"
                                    Padding="12,7"
                                    FontSize="11"
                                    Content="{Binding SortDirText}"
                                    AutomationProperties.Name="Toggle sort direction" />

                            <Border Width="1" Height="18"
                                    Background="{DynamicResource Brush.Line}"
                                    Margin="14,0"
                                    VerticalAlignment="Center" />

                            <TextBlock Text="AUTO-REFRESH"
                                       Style="{StaticResource Fx.SectionLabel}"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource Fx.Toggle}"
                                      IsChecked="{Binding AutoRefresh, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Auto refresh every 15 seconds" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Fx.BtnAcid}"
                                    Content="JOIN BEST"
                                    Click="JoinBest_Click"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding CanJoinBest}"
                                    AutomationProperties.Name="Join best ping server" />
                            <Button Style="{StaticResource Fx.Btn}"
                                    Content="EMPTIEST"
                                    Click="JoinEmptiest_Click"
                                    Margin="0,0,14,0"
                                    IsEnabled="{Binding CanJoinBest}"
                                    AutomationProperties.Name="Join emptiest server" />
                            <Button Style="{StaticResource Fx.Btn}"
                                    Content="REFRESH"
                                    Click="Refresh_Click"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="Refresh server list" />
                            <Button Style="{StaticResource Fx.Btn}"
                                    Content="LOAD MORE"
                                    Click="LoadMore_Click"
                                    Visibility="{Binding HasMore, Converter={StaticResource Conv.BoolVis}}"
                                    AutomationProperties.Name="Load more servers" />
                        </StackPanel>
                    </Grid>

                    <!-- ── server table ── -->
                    <Border Grid.Row="5" Style="{StaticResource Fx.Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource Brush.LineSoft}">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="PING (MS)" Style="{StaticResource Fx.SectionLabel}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="PLAYERS" Style="{StaticResource Fx.SectionLabel}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="SERVER ID" Style="{StaticResource Fx.SectionLabel}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="JOIN" Style="{StaticResource Fx.SectionLabel}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SrvRow}"
                                                        PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="110" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding PingText}"
                                                                   Foreground="{Binding PingBrush}"
                                                                   FontFamily="{DynamicResource Font.Mono}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding PlayersText}"
                                                                       Width="50"
                                                                       FontFamily="{DynamicResource Font.Mono}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource Brush.Text}"
                                                                       VerticalAlignment="Center" />
                                                            <Border Width="78" Height="5"
                                                                    CornerRadius="2.5"
                                                                    Background="{DynamicResource Brush.Line}"
                                                                    Margin="6,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <Border Width="{Binding FillWidth}"
                                                                        Height="5"
                                                                        CornerRadius="2.5"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Center"
                                                                        Background="{DynamicResource Brush.Acid}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding ShortId}"
                                                                   ToolTip="{Binding Id}"
                                                                   Foreground="{DynamicResource Brush.Dim}"
                                                                   FontFamily="{DynamicResource Font.Mono}"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center" />

                                                        <Button Grid.Column="4"
                                                                Style="{StaticResource Fx.BtnAcid}"
                                                                Content="JOIN"
                                                                Height="26"
                                                                Padding="16,0"
                                                                FontSize="10.5"
                                                                FontWeight="SemiBold"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                Tag="{Binding Id}"
                                                                Click="Join_Click"
                                                                AutomationProperties.Name="{Binding JoinName}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="{Binding PlaceholderText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Mono}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource Brush.Dim}"
                                           Visibility="{Binding ShowPlaceholder, Converter={StaticResource Conv.BoolVis}}"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ── activity log ── -->
                    <Border Grid.Row="7" Style="{StaticResource Fx.Terminal}" Height="132">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="ACTIVITY LOG"
                                       Style="{StaticResource Fx.SectionLabel}"
                                       Margin="0,0,0,6" />
                            <ScrollViewer Grid.Row="1" x:Name="LogScroll"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Logs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <TextBlock Text="{Binding Time}" Width="56"
                                                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                           Foreground="{DynamicResource Brush.Dim}" />
                                                <TextBlock Text="{Binding Level}" Width="48"
                                                           FontFamily="{DynamicResource Font.Mono}" FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Color}" />
                                                <TextBlock Text="{Binding Message}"
                                                           FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                                           Foreground="{Binding Color}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- CRT scanline overlay -->
                <Border Grid.Row="0" Grid.RowSpan="2"
                        Background="{StaticResource Brush.Scanline}"
                        IsHitTestVisible="False"
                        CornerRadius="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
